    outlier.shape = NA,
    alpha = 0.7,
    colour = "black"
  ) +
  geom_jitter(width = 0.12, size = 1.5, alpha = 0.55) +
  scale_fill_manual(values = class_colors, drop = FALSE) +
  facet_wrap(~ Metric, scales = "free_y", ncol = 2) +
  labs(x = NULL, y = NULL) +
  base_theme +
  theme(
    legend.position = "none",
    axis.text.x = element_text(angle = 25, hjust = 1)
  )

save_plot(
  complexity_plot,
  "sequence_complexity_by_classification.png",
  9,
  plot_height
)

# ------------------------------------------------------------
# 11. Amino-acid pairs and triplets
# ------------------------------------------------------------

pair_data <- clean_data %>%
  select(Peptide, Classification) %>%
  mutate(Pair = map(Peptide, get_ngrams, n = 2)) %>%
  unnest(Pair)

pair_composition <- pair_data %>%
  count(Classification, Pair, name = "Count") %>%
  group_by(Classification) %>%
  mutate(Percentage = 100 * Count / sum(Count)) %>%
  ungroup()

top_pairs_by_class <- pair_composition %>%
  group_by(Classification) %>%
  arrange(desc(Count), Pair, .by_group = TRUE) %>%
  slice_head(n = top_n_ngrams) %>%
  ungroup()

top_pairs_nontryptic <- pair_composition %>%
  filter(Classification == "Non-tryptic") %>%
  arrange(desc(Count), Pair) %>%
  slice_head(n = top_n_ngrams)

triplet_data <- clean_data %>%
  select(Peptide, Classification) %>%
  mutate(Triplet = map(Peptide, get_ngrams, n = 3)) %>%
  unnest(Triplet)

triplet_composition <- triplet_data %>%
  count(Classification, Triplet, name = "Count") %>%
  group_by(Classification) %>%
  mutate(Percentage = 100 * Count / sum(Count)) %>%
  ungroup()

top_triplets_by_class <- triplet_composition %>%
  group_by(Classification) %>%
  arrange(desc(Count), Triplet, .by_group = TRUE) %>%
  slice_head(n = top_n_ngrams) %>%
  ungroup()

top_triplets_nontryptic <- triplet_composition %>%
  filter(Classification == "Non-tryptic") %>%
  arrange(desc(Count), Triplet) %>%
  slice_head(n = top_n_ngrams)

pair_plot <- ggplot(
  top_pairs_nontryptic,
  aes(x = reorder(Pair, Count), y = Count)
