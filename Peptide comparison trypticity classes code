) +
  geom_col(position = position_dodge(width = 0.8), width = 0.75) +
  scale_fill_manual(values = class_colors, drop = FALSE) +
  labs(
    x = "Amino acid",
    y = "Amino-acid frequency (%)",
    fill = "Peptide class"
  ) +
  base_theme

save_plot(
  aa_plot,
  "amino_acid_composition_by_classification.png",
  9,
  plot_height
)

nontryptic_aa <- aa_composition %>%
  filter(Classification == "Non-tryptic") %>%
  arrange(desc(Percentage))

# ------------------------------------------------------------
# 9. Amino-acid group composition
# ------------------------------------------------------------

aa_groups <- tibble(
  Amino_acid = all_amino_acids,
  AA_group = c(
    "Hydrophobic", "Polar", "Acidic", "Acidic", "Aromatic",
    "Gly/Pro", "Basic", "Hydrophobic", "Basic", "Hydrophobic",
    "Hydrophobic", "Polar", "Gly/Pro", "Polar", "Basic",
    "Ser/Thr", "Ser/Thr", "Hydrophobic", "Aromatic", "Aromatic"
  )
)

group_composition <- aa_long %>%
  left_join(aa_groups, by = "Amino_acid") %>%
  count(Classification, AA_group, name = "Count") %>%
  group_by(Classification) %>%
  mutate(Percentage = 100 * Count / sum(Count)) %>%
  ungroup()

group_plot <- ggplot(
  group_composition,
  aes(x = AA_group, y = Percentage, fill = Classification)
) +
  geom_col(position = position_dodge(width = 0.8), width = 0.75) +
  scale_fill_manual(values = class_colors, drop = FALSE) +
  labs(
    x = NULL,
    y = "Amino-acid group frequency (%)",
    fill = "Peptide class"
  ) +
  base_theme +
  theme(axis.text.x = element_text(angle = 35, hjust = 1))

save_plot(
  group_plot,
  "amino_acid_group_composition.png",
  8,
  plot_height
)

# ------------------------------------------------------------
# 10. Sequence-complexity comparison
# ------------------------------------------------------------

complexity_data <- clean_data %>%
  mutate(
    Unique_AA_fraction = map_dbl(Peptide, unique_aa_fraction),
    Shannon_entropy = map_dbl(Peptide, shannon_entropy)
  )

complexity_summary <- complexity_data %>%
  group_by(Classification) %>%
  summarise(
    n = n(),
    mean_unique_fraction = mean(Unique_AA_fraction, na.rm = TRUE),
    sd_unique_fraction = sd(Unique_AA_fraction, na.rm = TRUE),
    median_unique_fraction = median(Unique_AA_fraction, na.rm = TRUE),
    mean_entropy = mean(Shannon_entropy, na.rm = TRUE),
    sd_entropy = sd(Shannon_entropy, na.rm = TRUE),
    median_entropy = median(Shannon_entropy, na.rm = TRUE),
    .groups = "drop"
  )

complexity_variables <- c("Unique_AA_fraction", "Shannon_entropy")

complexity_kruskal <- map_dfr(
  complexity_variables,
  ~ run_kruskal_test(complexity_data, .x)
)

complexity_pairwise <- map_dfr(
  complexity_variables,
  ~ run_pairwise_wilcox(complexity_data, .x)
)

complexity_long <- complexity_data %>%
  select(Classification, Unique_AA_fraction, Shannon_entropy) %>%
  pivot_longer(
    cols = c(Unique_AA_fraction, Shannon_entropy),
    names_to = "Metric",
    values_to = "Value"
  ) %>%
  mutate(
