    title = "Top amino-acid pairs in non-tryptic peptides"
  ) +
  base_theme

triplet_plot <- ggplot(
  top_triplets_nontryptic,
  aes(x = reorder(Triplet, Count), y = Count)
) +
  geom_col(fill = class_colors[["Non-tryptic"]]) +
  coord_flip() +
  labs(
    x = "Amino-acid triplet",
    y = "Frequency",
    title = "Top amino-acid triplets in non-tryptic peptides"
  ) +
  base_theme

