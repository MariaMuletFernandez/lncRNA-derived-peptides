    Q3 = quantile(Length, 0.75, na.rm = TRUE),
    min_length = min(Length, na.rm = TRUE),
    max_length = max(Length, na.rm = TRUE),
    .groups = "drop"
  )

length_kruskal <- run_kruskal_test(clean_data, "Length")
length_pairwise <- run_pairwise_wilcox(clean_data, "Length")

length_plot <- ggplot(
  clean_data,
  aes(x = Classification, y = Length, fill = Classification)
) +
  geom_violin(trim = FALSE, alpha = 0.5, colour = NA) +
