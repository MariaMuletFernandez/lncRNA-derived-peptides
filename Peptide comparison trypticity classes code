      Unique_AA_fraction = "Unique amino-acid fraction",
      Shannon_entropy = "Shannon entropy"
    )
  )

complexity_plot <- ggplot(
  complexity_long,
  aes(x = Classification, y = Value, fill = Classification)
) +
