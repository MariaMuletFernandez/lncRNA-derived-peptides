# 12. Physicochemical-property comparison
# ------------------------------------------------------------

physicochemical_data <- complexity_data %>%
  mutate(
    Molecular_weight = map_dbl(
      Peptide,
      ~ safe_peptide_metric(.x, Peptides::mw)
    ),
    Isoelectric_point = map_dbl(
      Peptide,
      ~ safe_peptide_metric(.x, Peptides::pI)
    ),
    Hydrophobicity = map_dbl(
      Peptide,
      ~ safe_peptide_metric(
        .x,
        Peptides::hydrophobicity,
        scale = "KyteDoolittle"
      )
    ),
    Net_charge_pH7 = map_dbl(
      Peptide,
      ~ safe_peptide_metric(.x, Peptides::charge, pH = 7)
    ),
    Boman_index = map_dbl(
      Peptide,
      ~ safe_peptide_metric(.x, Peptides::boman)
    )
  )

physicochemical_variables <- c(
  "Molecular_weight",
  "Isoelectric_point",
  "Hydrophobicity",
  "Net_charge_pH7",
  "Boman_index"
)

physicochemical_summary <- physicochemical_data %>%
  group_by(Classification) %>%
  summarise(
    n = n(),
    across(
      all_of(physicochemical_variables),
      list(
        mean = ~ mean(.x, na.rm = TRUE),
        sd = ~ sd(.x, na.rm = TRUE),
        median = ~ median(.x, na.rm = TRUE)
      ),
      .names = "{.col}_{.fn}"
    ),
    .groups = "drop"
  )

physicochemical_kruskal <- map_dfr(
  physicochemical_variables,
  ~ run_kruskal_test(physicochemical_data, .x)
)

physicochemical_pairwise <- map_dfr(
  physicochemical_variables,
  ~ run_pairwise_wilcox(physicochemical_data, .x)
)

physicochemical_long <- physicochemical_data %>%
  select(Classification, all_of(physicochemical_variables)) %>%
  pivot_longer(
    cols = all_of(physicochemical_variables),
    names_to = "Property",
    values_to = "Value"
  ) %>%
  mutate(
    Property = recode(
      Property,
      Molecular_weight = "Molecular weight",
      Isoelectric_point = "Isoelectric point",
      Hydrophobicity = "Hydrophobicity",
      Net_charge_pH7 = "Net charge at pH 7",
      Boman_index = "Boman index"
    )
  )

physicochemical_plot <- ggplot(
