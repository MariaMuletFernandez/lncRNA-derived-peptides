  stop(
    paste0(
      "Input file not found: ", input_file,
      "\nUpdate input_file in the USER CONFIGURATION section."
    ),
    call. = FALSE
  )
}

dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

raw_data <- read_excel(input_file, sheet = input_sheet) %>%
  as.data.frame()

check_required_columns(
  raw_data,
  c(peptide_column, classification_column)
)

cat("Classification labels detected in the input file:\n")
print(table(raw_data[[classification_column]], useNA = "ifany"))

# ------------------------------------------------------------
# 5. Clean sequences and standardize classifications
# ------------------------------------------------------------

clean_data <- raw_data %>%
  mutate(
    Peptide = clean_peptide_sequence(.data[[peptide_column]]),
    Classification_original = as.character(.data[[classification_column]]),
    Classification = standardize_classification(
      .data[[classification_column]]
    ),
    Calculated_length = nchar(Peptide)
  )

unrecognized_labels <- clean_data %>%
  filter(
    !is.na(Classification_original),
    str_trim(Classification_original) != "",
    is.na(Classification)
  ) %>%
  count(Classification_original, name = "Count") %>%
  arrange(desc(Count))

clean_data <- clean_data %>%
  filter(
    !is.na(Peptide),
    Peptide != "",
    !is.na(Classification)
  )

if (!is.null(length_column) && length_column %in% colnames(raw_data)) {
  clean_data <- clean_data %>%
    mutate(
      Reported_length = suppressWarnings(
        as.numeric(.data[[length_column]])
      ),
      Length_difference = Reported_length - Calculated_length
    )
} else {
  clean_data <- clean_data %>%
    mutate(
      Reported_length = NA_real_,
      Length_difference = NA_real_
    )
}

clean_data <- clean_data %>%
  mutate(
    Length = Calculated_length,
    Classification = factor(
      Classification,
      levels = c("Tryptic", "Semi-tryptic", "Non-tryptic")
    )
  )

class_counts <- clean_data %>%
  count(Classification, name = "Peptide_count") %>%
  complete(
    Classification = factor(
      c("Tryptic", "Semi-tryptic", "Non-tryptic"),
      levels = c("Tryptic", "Semi-tryptic", "Non-tryptic")
    ),
    fill = list(Peptide_count = 0)
  )

if (any(class_counts$Peptide_count == 0)) {
  missing_classes <- class_counts %>%
    filter(Peptide_count == 0) %>%
    pull(Classification) %>%
    as.character()

  stop(
    paste0(
      "The analysis requires all three classifications, but no valid ",
      "peptides were found for: ",
      paste(missing_classes, collapse = ", "),
      ".\nCheck the values in the classification column."
    ),
    call. = FALSE
  )
}

cat("\nPeptides retained after cleaning:\n")
print(class_counts)

