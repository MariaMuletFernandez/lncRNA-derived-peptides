# ------------------------------------------------------------
# 3. Helper functions
# ------------------------------------------------------------

check_required_columns <- function(data, required_columns) {
  missing_columns <- setdiff(required_columns, colnames(data))

  if (length(missing_columns) > 0) {
    stop(
      paste0(
        "The input file is missing the following required column(s): ",
        paste(missing_columns, collapse = ", "),
        ".\nUpdate peptide_column and classification_column in the ",
        "USER CONFIGURATION section."
      ),
      call. = FALSE
    )
  }
}

clean_peptide_sequence <- function(sequence) {
  sequence <- toupper(str_trim(as.character(sequence)))
  str_replace_all(sequence, "[^ACDEFGHIKLMNPQRSTVWY]", "")
}

standardize_classification <- function(classification) {
  normalized <- classification %>%
    as.character() %>%
    str_trim() %>%
    str_to_lower() %>%
    str_replace_all("_", "-") %>%
    str_squish()

  case_when(
    normalized %in% c(
      "tryptic", "triptico", "tríptico"
    ) ~ "Tryptic",

    normalized %in% c(
      "semi-tryptic", "semitryptic", "semi tryptic",
      "semi-triptico", "semitriptico", "semi-tríptico"
    ) ~ "Semi-tryptic",

    normalized %in% c(
      "non-tryptic", "non tryptic", "nontryptic",
      "no triptico", "no tríptico", "non-triptico",
      "non-tríptico"
    ) ~ "Non-tryptic",

    TRUE ~ NA_character_
  )
}

unique_aa_fraction <- function(sequence) {
  residues <- str_split(sequence, "", simplify = FALSE)[[1]]

  if (length(residues) == 0) {
    return(NA_real_)
  }

  length(unique(residues)) / length(residues)
}

shannon_entropy <- function(sequence) {
  residues <- str_split(sequence, "", simplify = FALSE)[[1]]

  if (length(residues) == 0) {
    return(NA_real_)
  }

  frequencies <- table(residues) / length(residues)
  -sum(frequencies * log2(frequencies))
}

get_ngrams <- function(sequence, n) {
  sequence_length <- nchar(sequence)

  if (is.na(sequence_length) || sequence_length < n) {
    return(character(0))
  }

  start_positions <- seq_len(sequence_length - n + 1)

  str_sub(
    sequence,
    start = start_positions,
    end = start_positions + n - 1
  )
}

safe_peptide_metric <- function(sequence, metric_function, ...) {
  tryCatch(
    metric_function(sequence, ...),
    error = function(error) NA_real_
  )
}

save_plot <- function(plot_object, filename, width, height) {
  ggsave(
    filename = file.path(output_dir, filename),
    plot = plot_object,
    width = width,
    height = height,
    units = "in",
    dpi = 300
  )
}

run_kruskal_test <- function(data, variable) {
  valid_data <- data %>%
    filter(!is.na(.data[[variable]]), !is.na(Classification))

  if (n_distinct(valid_data$Classification) < 2) {
    return(tibble(
      Variable = variable,
      Statistic = NA_real_,
      Degrees_of_freedom = NA_real_,
      P_value = NA_real_
    ))
  }

  test <- kruskal.test(
    reformulate("Classification", response = variable),
    data = valid_data
  )

  tibble(
    Variable = variable,
    Statistic = unname(test$statistic),
    Degrees_of_freedom = unname(test$parameter),
    P_value = test$p.value
  )
}

run_pairwise_wilcox <- function(data, variable) {
  valid_data <- data %>%
    filter(!is.na(.data[[variable]]), !is.na(Classification))

  if (n_distinct(valid_data$Classification) < 2) {
    return(tibble())
  }

  test <- pairwise.wilcox.test(
    x = valid_data[[variable]],
    g = valid_data$Classification,
    p.adjust.method = "BH",
    exact = FALSE
  )

  as.data.frame(as.table(test$p.value), stringsAsFactors = FALSE) %>%
    filter(!is.na(Freq)) %>%
    transmute(
      Variable = variable,
      Group_1 = as.character(Var1),
      Group_2 = as.character(Var2),
      Adjusted_P_value = as.numeric(Freq),
      Significant = Adjusted_P_value < alpha
    )
}

# ------------------------------------------------------------
# 4. Read and validate the input file
# ------------------------------------------------------------

